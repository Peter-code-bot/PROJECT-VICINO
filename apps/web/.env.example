# === REQUERIDAS ===
# Supabase — obtener de supabase.com/dashboard/project/[ref]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key-aqui

# URL del sitio (cambiar a tu dominio en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === PANEL DE ADMIN ===
# Clave de operacion que el panel pide antes de conceder o quitar un rol
# (lib/admin/clave-de-seguridad.ts). NO es la contrasena de nadie: es una
# segunda llave compartida por quienes administran, para que un clic suelto en
# una sesion abierta no reparta el panel. Si falta, el panel RECHAZA los
# cambios de rol y lo dice: un panel sin segunda llave no puede fingir que la
# pide. Se configura en Vercel (Production), nunca en el repositorio, que es
# publico.
ADMIN_SECURITY_PASSWORD=

# === NOTAS ===
# Google OAuth se configura en Supabase Dashboard → Authentication → Providers → Google
# No se necesitan variables de entorno aquí para OAuth — Supabase lo maneja internamente
