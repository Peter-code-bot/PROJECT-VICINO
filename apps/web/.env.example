# === REQUERIDAS ===
# Supabase — obtener de supabase.com/dashboard/project/[ref]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key-aqui

# URL del sitio (cambiar a tu dominio en producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapa S10: migración 20260930220000 aplicada y validada en producción.
# Activo por defecto. false lo desactiva; requiere un nuevo build/despliegue.
NEXT_PUBLIC_VICINO_MAP_ENABLED=true
# Mapa: proyección pública de las publicaciones. Falla cerrado: solo "v3"
# activa las celdas de ~110 m (migración 20261020150000 aplicada); vacío, "v2"
# o cualquier otro valor deja la proyección de ~1 km (decisión S10).
VICINO_MAPA_RPC=

# === PANEL DE ADMIN ===
# Clave de operacion que el panel pide antes de conceder o quitar un rol
# (lib/admin/clave-de-seguridad.ts). NO es la contrasena de nadie: es una
# segunda llave compartida por quienes administran, para que un clic suelto en
# una sesion abierta no reparta el panel. Si falta, el panel RECHAZA los
# cambios de rol y lo dice: un panel sin segunda llave no puede fingir que la
# pide. Se configura en Vercel (Production), nunca en el repositorio, que es
# publico.
ADMIN_SECURITY_PASSWORD=

# === TARJETAS DE LEALTAD EN WALLET (opcional; sin estas, la app muestra solo la tarjeta interna) ===
# Apple: Pass Type ID + certificado emitidos en developer.apple.com (Certificates, Identifiers & Profiles)
# y el certificado intermedio WWDR G4. Los PEM se pegan completos (con \n) o en base64. Nunca en el repo.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=
# Google: cuenta emisora de Pay & Wallet Console (numerica) y cuenta de servicio autorizada con la Wallet API.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
# La cola de sincronizacion (/api/cron/wallet-sync) usa el mismo CRON_SECRET que recompute-rankings.

# === PRUEBAS E2E (solo en .env.local, nunca en el repositorio) ===
# Cuenta de pruebas con la que playwright.config.ts inicia sesion (tests/seed.spec.ts).
VICINO_TEST_EMAIL=
VICINO_TEST_PASSWORD=
# Segunda cuenta de pruebas para el cambio de cuenta (tests/cuentas.spec.ts).
# Sin ella esos casos se saltan, no fallan.
VICINO_TEST_EMAIL_2=
VICINO_TEST_PASSWORD_2=

# === NOTAS ===
# Google OAuth se configura en Supabase Dashboard → Authentication → Providers → Google
# No se necesitan variables de entorno aquí para OAuth — Supabase lo maneja internamente
