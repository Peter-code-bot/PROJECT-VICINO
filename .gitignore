apps/web/playwright-report/
apps/web/test-results/
apps/web/playwright/.cache/

# Config local del dev server (Claude Code). Es por maquina, no se comparte.
.claude/launch.json

# Generados por el build del service worker de Workbox. Se regeneran en cada
# build, asi que trackearlos solo produce ruido en cada diff.
apps/web/public/workbox-*.js
apps/web/public/workbox-*.js.map

# Estado local del proyecto de staging (claves de ESE proyecto)
.staging/

# Seeds nuevos con datos de cuentas: el repo es PUBLICO. Un seed local
# (p. ej. supabase/seed-villahermosa-estradajr.sql, que existe sin versionar
# en otro equipo) no puede entrar por un `git add -A`. Los seeds ya versionados
# (seed.sql, seed-dev.sql, seed-v2.sql, seed-pedro-tech-playstore.sql) no se
# ven afectados. Uno nuevo se agrega a proposito con `git add -f` despues de
# revisar que no lleva correos, telefonos ni ids de cuentas reales.
supabase/seed-*.sql
/seed-*.sql

.agents/
