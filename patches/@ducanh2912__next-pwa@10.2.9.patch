index 0000000000000000000000000000000000000000..1b178239ea9afaecb250190b5a86a52b2be6517b
--- /dev/null
+++ b/dist/glob-compat.cjs	
@@ -0,0 +1,28 @@
+'use strict';
+
+const { globSync } = require('tinyglobby');
+
+// Keep the fast-glob behavior used by next-pwa's four build-time call sites.
+// tinyglobby expands literal directories by default and suffixes directories.
+const trimDirectorySuffix = (entry) =>
+  /\/$/.test(entry) && !/^(?:\/|[A-Za-z]:\/)$/u.test(entry)
+    ? entry.slice(0, -1)
+    : entry;
+
+const toPosix = (pattern) =>
+  typeof pattern === 'string' ? pattern.replace(/\\/g, '/') : pattern;
+
+const sync = (patterns, options = {}) => {
+  const normalizedPatterns = Array.isArray(patterns)
+    ? patterns.map(toPosix)
+    : toPosix(patterns);
+  const opts = { cwd: process.cwd(), ...options, expandDirectories: false };
+  if (opts.ignore) {
+    opts.ignore = Array.isArray(opts.ignore)
+      ? opts.ignore.map(toPosix)
+      : toPosix(opts.ignore);
+  }
+  return globSync(normalizedPatterns, opts).map(trimDirectorySuffix);
+};
+
+module.exports = { sync };
